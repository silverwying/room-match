# Copie este arquivo para .env e preencha com os valores reais do seu ambiente.
# O .env nunca deve ser commitado (veja .gitignore).

# --- Banco de dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=roommatch

# --- Segurança (autenticação JWT) ---
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
